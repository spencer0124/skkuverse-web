# Which ConsoleApi implementation runs. Defaults to `mock` when unset — see
# src/api/client.ts. `http` requires VITE_API_BASE and throws without it, on
# purpose: a console silently talking to nowhere shows empty lists that look
# like empty data.
VITE_API_MODE=mock

# skkuverse-server origin. Only read when VITE_API_MODE=http.
# VITE_API_BASE=https://api.skkuverse.com
